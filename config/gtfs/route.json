{
    "default_route_id_enabled": true,
    "use_route_short_name_for_route_id": false,
    "route_id_cleanup_regex": "\\-[A-Z]+$",
    "default_route_long_name_enabled": true,
    "route_colors_ignored": [
        "000000"
    ],
    "route_colors": [
        {
            "route_short_name": "1",
            "color": "004B8D"
        },
        {
            "route_short_name": "1R",
            "color": "004B8D"
        },
        {
            "route_short_name": "2",
            "color": "8CC63F"
        },
        {
            "route_short_name": "2A",
            "color": "8CC63F"
        },
        {
            "route_short_name": "2B",
            "color": "8CC63F"
        },
        {
            "route_short_name": "3",
            "color": "F37421"
        },
        {
            "route_short_name": "30",
            "color": "8177B7"
        },
        {
            "route_short_name": "31",
            "color": "FCAF17"
        }
    ],
    "direction_finder_enabled": true,
    "direction_headsign_cleaners": [
        {
            "regex": "(\\s*-\\s*reverse route)$",
            "ignore_case": true
        }
    ],
    "trip_headsign_remove_via": true,
    "trip_headsign_cleaners": [
        {
            "regex": "(\\s*\\-\\s*via\\s*)",
            "ignore_case": true,
            "replacement": " via "
        }
    ],
    "stop_name_cleaners": []
}
